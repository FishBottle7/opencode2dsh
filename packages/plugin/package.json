{
  "name": "@opencode2dsh/dsh-plugin",
  "version": "0.2.0",
  "description": "DSH cordis plugin: spawn and shepherd the opencode2dsh agent (local OpenCode Zen anonymous-lane proxy) and register it as an llm-pi-ai provider",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir lib",
    "prepack": "pnpm build && node ../../scripts/stamp-bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "opencode",
    "zen"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@google/genai",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
